# Local mode is deterministic and requires no credentials.
PORTAL_PORT=3000
SUPPORT_API_PORT=4000
SUPPORT_API_BASE_URL=http://127.0.0.1:4000
AGENT_MODE=stub
SUPPORT_API_REQUIRE_AUTH=0
OTEL_ENABLED=0
DEMO_CORRELATION_ID=ACME-LAB-LOCAL

# Optional server-only watsonx Orchestrate mode. Never use NEXT_PUBLIC_ names.
# AGENT_MODE=orchestrate
# WXO_API_ENDPOINT=https://api.<region>.dl.watson-orchestrate.ibm.com/instances/<instance-id>
# WXO_AGENT_ID=<agent-id>
# WXO_API_KEY=<load-from-your-secret-store>

# Optional OpenTelemetry export. Keep credentials outside tracked files.
# OTEL_ENABLED=1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# OTEL_SERVICE_NAME=acme-support-api
# DEPLOYMENT_ENVIRONMENT=local-lab

# Optional Instana blue SaaS OTLP/HTTP adapter. Values remain server-only.
# INSTANA_AGENT_KEY=<load-from-your-secret-store>
# INSTANA_OTLP_HTTP_ENDPOINT=https://otlp-http-blue-saas.instana.io:443
# INSTANA_OTLP_HOST=<safe-logical-host-name>
