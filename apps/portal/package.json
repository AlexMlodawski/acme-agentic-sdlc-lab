    "@testing-library/user-event": "14.6.6",
    "@types/node": "24.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.3",
    "jsdom": "26.1.0",
    "typescript": "5.9.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.0.0",
