{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acme.example.invalid/schemas/release-evidence.schema.json",
  "title": "Acme release audit evidence",
  "description": "A redacted, machine-readable record of checks executed for one release candidate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "candidate",
    "mode",
    "dry_run",
    "created_at",
    "completed_at",
    "output_directory",
    "source",
    "overall_status",
    "hard_gate_passed",
    "steps"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "candidate": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "mode": {
      "enum": ["Quick", "Full"]
    },
    "dry_run": {
      "type": "boolean"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "output_directory": {
      "type": "string",
      "pattern": "^release-evidence/[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "overall_status": {
      "$ref": "#/$defs/status"
    },
    "hard_gate_passed": {
      "type": "boolean"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "status": {
      "enum": ["pass", "fail", "not_completed", "not_asserted"]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha",
        "branch",
        "detached",
        "dirty",
        "allow_dirty",
        "status_porcelain",
        "status_digest_sha256",
        "captured_at"
      ],
      "properties": {
        "sha": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "branch": {
          "type": ["string", "null"]
        },
        "detached": {
          "type": "boolean"
        },
        "dirty": {
          "type": "boolean"
        },
        "allow_dirty": {
          "type": "boolean"
        },
        "status_porcelain": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status_digest_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "command",
        "status",
        "hard_gate",
        "started_at",
        "completed_at",
        "duration_ms",
        "exit_code",
        "log"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "hard_gate": {
          "type": "boolean"
        },
        "started_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "completed_at": {
          "type": ["string", "null"],
          "format": "date-time"
        },
        "duration_ms": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "exit_code": {
          "type": ["integer", "null"]
        },
        "log": {
          "type": "string",
          "pattern": "^steps/[0-9]{2}-[a-z0-9]+(?:-[a-z0-9]+)*\\.log$"
        },
        "artifact": {
          "type": "string",
          "pattern": "^artifacts/[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
