{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/acme-bob-review-1.0.json",
  "title": "Sanitized Bob Shell advisory review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "candidate",
    "controller",
    "review",
    "gateEvidence",
    "deterministicGates",
    "summary",
    "checks",
    "findings",
    "notAsserted",
    "recommendation"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "candidate": { "$ref": "#/$defs/commit" },
    "controller": { "$ref": "#/$defs/commit" },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewer",
        "reviewedAt",
        "status",
        "bobVersion",
        "sourceMutationGuard",
        "workspacePolicyGuard",
        "maxCost",
        "maxTurns",
        "toolCalls",
        "disabledToolGroups"
      ],
      "properties": {
        "reviewer": { "const": "Bob Shell" },
        "reviewedAt": { "type": "string", "format": "date-time" },
        "status": { "const": "pass" },
        "bobVersion": { "const": "2.0.2" },
        "sourceMutationGuard": { "const": "pass" },
        "workspacePolicyGuard": { "const": "pass" },
        "maxCost": { "type": "number", "exclusiveMinimum": 0, "maximum": 5 },
        "maxTurns": { "type": "integer", "minimum": 1, "maximum": 30 },
        "toolCalls": { "type": "integer", "minimum": 1 },
        "disabledToolGroups": {
          "const": ["edit", "execute", "mcp", "skill", "todo", "subagent", "mode"]
        }
      }
    },
    "gateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceJob", "workflowRunId", "workflowRunAttempt"],
      "properties": {
        "sourceJob": { "const": "deterministic-gates" },
        "workflowRunId": { "type": "string", "pattern": "^[1-9][0-9]{0,30}$" },
        "workflowRunAttempt": { "type": "string", "pattern": "^[1-9][0-9]{0,30}$" }
      }
    },
    "deterministicGates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": { "$ref": "#/$defs/gate" }
    },
    "summary": { "$ref": "#/$defs/longText" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/check" }
    },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/finding" }
    },
    "notAsserted": {
      "type": "array",
      "maxItems": 100,
      "items": { "$ref": "#/$defs/notAsserted" }
    },
    "recommendation": {
      "enum": ["ready_for_human_review", "changes_required", "not_ready"]
    }
  },
  "$defs": {
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha"],
      "properties": { "sha": { "type": "string", "pattern": "^[0-9a-f]{40}$" } }
    },
    "text": { "type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S" },
    "longText": { "type": "string", "minLength": 1, "maxLength": 8000, "pattern": "\\S" },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "evidence"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
        "status": { "enum": ["pass", "fail", "not_completed", "not_asserted"] },
        "evidence": { "$ref": "#/$defs/text" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "command", "status", "evidence"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "\\S" },
        "command": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "\\S" },
        "status": { "const": "pass" },
        "evidence": { "$ref": "#/$defs/text" }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "severity", "area", "observation", "evidence", "recommendation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,30}$" },
        "severity": { "enum": ["low", "medium", "high", "critical"] },
        "area": { "$ref": "#/$defs/text" },
        "observation": { "$ref": "#/$defs/text" },
        "evidence": { "$ref": "#/$defs/text" },
        "recommendation": { "$ref": "#/$defs/text" }
      }
    },
    "notAsserted": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim", "reason", "evidenceNeeded"],
      "properties": {
        "claim": { "$ref": "#/$defs/text" },
        "reason": { "$ref": "#/$defs/text" },
        "evidenceNeeded": { "$ref": "#/$defs/text" }
      }
    }
  }
}
